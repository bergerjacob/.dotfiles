    {
      "source": "npm:@davecodes/pi-dcp@0.2.0",
      "extensions": []
    },
    "npm:pi-sandbox",
    {
      "source": "git:github.com/cgxeiji/pi-emote",
      "extensions": [],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "npm:@bizmyth/pi-neovim-editor",
    "npm:pi-claude-bridge"
  ]
