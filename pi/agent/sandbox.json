{
  "enabled": true,
  "allowBrowserProcess": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnauthenticatedSocksProxy": true,
    "allowedDomains": ["*"],
    "deniedDomains": []
  },
  "filesystem": {
    "allowRead": [".", "~"],
    "allowWrite": [".", "/tmp", "~"],
    "denyRead": [],
    "denyWrite": [
      "~/.ssh",
      "~/.gnupg",
      "~/.pi/agent/auth.json",
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  }
}
