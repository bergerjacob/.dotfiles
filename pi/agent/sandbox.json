{
  "enabled": true,
  "filesystem": {
    "allowRead": [
      ".",
      "~"
    ],
    "allowWrite": [
      ".",
      "/tmp"
    ],
    "denyRead": [],
    "denyWrite": [
      "~/.ssh",
      "~/.gnupg",
      "~/.config",
      "~/.local/share",
      ".env",
      ".env.*",
      "*.pem",
      "*.key"
    ]
  },
  "network": {
