{
  "enabled": true,
  "allowBrowserProcess": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnauthenticatedSocksProxy": true,
    "allowedDomains": [
      "api.z.ai",
      "openrouter.ai",
      "generativelanguage.googleapis.com",
      "api.elevenlabs.io",
      "github.com",
      "*.github.com",
      "example.com"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "allowRead": [
      ".",
      "~"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "~"
    ],
    "denyRead": [],
    "denyWrite": [
      "~/.ssh",
      "~/.gnupg",
      "~/.pi/agent/auth.json",
      ".env",
      ".env.*",
      "*/.env",
      "*/.env.*",
      "*.pem",
      "*.key"
    ]
  }
}
