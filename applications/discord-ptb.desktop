[Desktop Entry]
Name=Discord PTB
StartupWMClass=discord-ptb
Comment=All-in-one voice and text chat for gamers that's free, secure, and works on both your desktop and phone.
GenericName=Internet Messenger
# Launch through the profile-overridden wrapper in ~/.local/bin (see
# bin/discord-ptb and pc/bin/discord-ptb) so the per-machine launch flags apply
# on the NVIDIA PC.
Exec=/home/bergerj/.local/bin/discord-ptb
Icon=discord-ptb
Type=Application
Categories=Network;InstantMessaging;
Path=/usr/bin
