[Desktop Entry]
Name=Discord
StartupWMClass=discord
Comment=All-in-one voice and text chat for gamers that's free, secure, and works on both your desktop and phone.
GenericName=Internet Messenger
# Launch through the profile-overridden wrapper in ~/.local/bin (see bin/discord
# and pc/bin/discord) so the per-machine launch flags apply on the NVIDIA PC.
Exec=/home/bergerj/.local/bin/discord
Icon=discord
Type=Application
Categories=Network;InstantMessaging;
Path=/usr/bin
